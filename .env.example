
# Modo de conexión:
# persistent = Playwright abre su propio navegador
# cdp = conectar a un navegador ya abierto
NOTEBOOKLM_CONNECTION=persistent

# Navegador para el modo persistent:
# chromium, firefox, chrome o msedge
NOTEBOOKLM_BROWSER=chromium

# Dirección local para el modo cdp
NOTEBOOKLM_CDP_URL=http://127.0.0.1:9222

# Cuaderno predeterminado (opcional)
NOTEBOOKLM_URL=
