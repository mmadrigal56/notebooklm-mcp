# Configuración recomendada para Windows: Microsoft Edge mediante CDP
NOTEBOOKLM_CONNECTION=cdp
NOTEBOOKLM_BROWSER=msedge
NOTEBOOKLM_CDP_URL=http://127.0.0.1:9222

# Consultas sin abrir una ventana de Edge
# Opciones: headless (sin ventana), hidden (oculta), visible
NOTEBOOKLM_CDP_WINDOW=headless

# Opcional: ruta de un perfil independiente de Edge
# NOTEBOOKLM_CDP_PROFILE=

# Alternativa: Chromium con Playwright (abre una ventana)
# NOTEBOOKLM_CONNECTION=persistent
# NOTEBOOKLM_BROWSER=chromium

# Cuaderno predeterminado (opcional)
NOTEBOOKLM_URL=